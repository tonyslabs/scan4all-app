{
  "name": "scan4all",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "mobile": "pnpm --filter ./apps/mobile start",
    "android": "pnpm --filter ./apps/mobile android",
    "ios": "pnpm --filter ./apps/mobile ios",
    "typecheck": "pnpm --filter ./apps/mobile exec tsc --noEmit",
    "api": "cd apps/api && python3 -m uvicorn main:app --host 127.0.0.1 --port 8000"
  }
}
